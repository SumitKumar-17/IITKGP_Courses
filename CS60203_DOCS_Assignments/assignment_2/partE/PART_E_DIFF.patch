+bool KVStore::create_index(size_t field_offset, size_t field_len) {
+    if (field_len == 0 || field_len > kInline) return false;
+    uint64_t lsn = 0;
+    {
+        std::lock_guard<std::mutex> g(write_mu_);
+        if (has_index_) return false;
+        if (wal_ && wal_->failed()) return false;
+        Version* old = current_.load(std::memory_order_relaxed);
+        Build b(old, ++build_seq_, pending_);
+        build_index(b, field_offset, field_len);
+        if (wal_) {
+            WalOp op{3, static_cast<long>(field_offset), nullptr, field_len};
+            lsn = wal_->append(&op, 1);
+            if (!lsn) { pending_.clear(); return false; }
+        }
+        publish(old, b);
+    }
+    if (wal_) wal_->wait_durable(lsn);
+    return true;
