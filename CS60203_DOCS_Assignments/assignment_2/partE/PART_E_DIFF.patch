+bool KVStore::open_wal(const std::string& path, const WalOptions& options, WalReplayInfo* replay,
+                       std::string* error) {
+    std::lock_guard<std::mutex> g(write_mu_);
+    std::string err;
+    if (wal_) {
+        if (error) *error = "a log is already open";
+        return false;
+    }
+    Version* old = current_.load(std::memory_order_relaxed);
+    Build b(old, ++build_seq_, pending_);
+
+    // Replay builds one new version out of every record, then publishes it once.
+    auto apply = [&](const WalOp* ops, size_t n) {
+        for (size_t i = 0; i < n; i++) {
+            if (ops[i].type == 1) apply_put(b, ops[i].key, ops[i].value, ops[i].len);
+            else if (ops[i].type == 2) apply_erase(b, ops[i].key);
+            else if (!has_index_) build_index(b, static_cast<size_t>(ops[i].key), ops[i].len);
+        }
+    };
+    WalReplayInfo info;
+    std::unique_ptr<Wal> w;
+    try {
+        w = Wal::open(path, options, apply, info, err);
+    } catch (const std::bad_alloc&) {
+        err = "out of memory while replaying the log";
+    }
+    if (replay) *replay = info;
+    if (!w) {
+        pending_.clear();
+        if (error) *error = err;
+        return false;
+    }
+    if (info.records > 0) publish(old, b); else pending_.clear();
+    wal_ = std::move(w);
     return true;
 }
 
+WalStats KVStore::wal_stats() const {
+    return wal_ ? wal_->stats() : WalStats{};
+}
