+KVStore::Snapshot& KVStore::Snapshot::operator=(Snapshot&& o) noexcept {
+    if (this == &o) return *this;
+    release();
+    slot_ = o.slot_;
+    nbound_ = o.nbound_;
+    for (int i = 0; i < kMaxStores; i++) bound_[i] = o.bound_[i];
+    o.slot_ = nullptr;
+    o.nbound_ = 0;
+    return *this;
