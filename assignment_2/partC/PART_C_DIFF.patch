+    Build b(old, ++build_seq_, pending_);
+    try {
+        for (const StagedWrite& w : writes) apply_put(b, w.key, data.data() + w.offset, w.len);
+    } catch (const std::bad_alloc&) {
+        return false;
+    }
+    publish(old, b);
+    return true;
